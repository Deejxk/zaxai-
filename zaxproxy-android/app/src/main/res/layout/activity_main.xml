<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Sign in -->
    <ScrollView
        android:id="@+id/login_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="64dp"
            android:paddingRight="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:text="@string/brand"
                android:textColor="@color/text"
                android:textSize="33sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                android:letterSpacing="0.18"
                android:paddingLeft="14dp"
                android:paddingTop="4dp"
                android:paddingRight="14dp"
                android:paddingBottom="4dp"
                android:text="@string/brand_sub"
                android:textAllCaps="true"
                android:textColor="#B3AAFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="30dp"
                android:text="@string/tagline"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stage"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/in_login"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_input"
                    android:hint="@string/email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/in_pass"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input"
                    android:hint="@string/password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/bad"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn"
                    android:stateListAnimator="@null"
                    android:text="@string/sign_in"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/link_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:text="@string/no_account"
                android:textColor="#B3AAFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/link_forgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/forgot"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Signed in -->
    <LinearLayout
        android:id="@+id/main_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="14dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_iconbtn"
                android:contentDescription="@string/refresh"
                android:padding="10dp"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/btn_logout"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_iconbtn"
                android:contentDescription="@string/sign_out"
                android:padding="10dp"
                android:src="@drawable/ic_logout" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="28dp">

                <!-- Connection stage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stage"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="26dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="22dp">

                    <FrameLayout
                        android:id="@+id/power"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:clickable="true"
                        android:contentDescription="@string/connect"
                        android:focusable="true">

                        <View
                            android:id="@+id/halo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.14"
                            android:background="@drawable/halo_idle" />

                        <View
                            android:id="@+id/ring"
                            android:layout_width="156dp"
                            android:layout_height="156dp"
                            android:layout_gravity="center"
                            android:alpha="0.55"
                            android:background="@drawable/ring_idle" />

                        <FrameLayout
                            android:id="@+id/disc"
                            android:layout_width="124dp"
                            android:layout_height="124dp"
                            android:layout_gravity="center"
                            android:background="@drawable/power_idle"
                            android:elevation="10dp">

                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_power" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/not_connected"
                        android:textColor="@color/text"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/tap_connect"
                        android:textColor="@color/muted"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip_ok"
                        android:fontFamily="monospace"
                        android:paddingLeft="14dp"
                        android:paddingTop="5dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/ok"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- The location that the big button connects to -->
                    <LinearLayout
                        android:id="@+id/selected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/sel_flag"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_flag"
                            android:gravity="center"
                            android:textSize="21sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/sel_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/selected_location"
                                android:textAllCaps="true"
                                android:textColor="@color/muted"
                                android:textSize="10.5sp"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/sel_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/text"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sel_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- GPS location: opens the map; can follow the connected proxy -->
                <LinearLayout
                    android:id="@+id/gps_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp">

                            <View
                                android:id="@+id/gps_halo"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:alpha="0.3"
                                android:background="@drawable/bg_gps_ico" />

                            <ImageView
                                android:id="@+id/gps_ico"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_gps_ico"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:src="@drawable/ic_pin" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/gps_head"
                                android:textAllCaps="true"
                                android:textColor="@color/muted"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/gps_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/gps_off"
                                android:textColor="@color/text"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/gps_open"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_btn"
                            android:paddingLeft="14dp"
                            android:paddingTop="9dp"
                            android:paddingRight="14dp"
                            android:paddingBottom="9dp"
                            android:text="@string/gps_open"
                            android:textColor="@color/white"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/gps_auto"
                                android:textColor="@color/text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/gps_auto_sub"
                                android:textColor="@color/muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/gps_auto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:textColor="@color/warn"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/locations"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="@drawable/bg_btn_ghost"
                        android:paddingLeft="12dp"
                        android:paddingTop="7dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="7dp"
                        android:text="@string/add_manual"
                        android:textColor="#CFC9FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="11dp"
                        android:paddingTop="3dp"
                        android:paddingRight="11dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/muted"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="14.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="@string/none_found"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_title"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/empty_sub"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_buy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="@string/buy"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
