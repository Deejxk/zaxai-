# Public HTTPS address of this server (used for Paystack callbacks and the MikroTik redirect page)
PUBLIC_URL=https://wifi.yourdomain.com

# Web server port (Caddy/Nginx proxies 443 -> this port)
PORT=3000

# Optional: create the admin account automatically on first start.
# If left empty, open /admin/setup in your browser right after deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Built-in RADIUS server for MikroTik (UDP). Open these ports in your VPS firewall.
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Where the SQLite database is stored
DATA_DIR=./data
